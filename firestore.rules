rules_version = '2';

// ExamPrepper Firestore rules.
//
// Model: a shared-device app with up to 4 no-password profiles. Profiles are NOT
// authentication identities -- every profile shares one anonymous session, and the
// active profile is a client-side selection. A rule can see that *someone* signed in,
// never *which profile* is asking.
//
// So per-profile test ownership is dashboard separation, not privacy: your tests stop
// appearing on other profiles' dashboards, but anyone holding the device can switch
// profile and see them. Read rules below are deliberately open because there is no
// profile identity to scope them to; claiming otherwise here would be misleading.
//
// Two things ARE enforced on the verified auth token, and hold even against a request
// made directly against the API rather than through the app:
//   1. Only the admin account may delete profiles, progress, or tests.
//   2. Only the admin account may publish a test to every profile (the `shared` flag).
//
// Limitation, stated plainly: the Firebase web config in app.js is public, so anyone
// can obtain an anonymous token and read or write profiles, progress, and test content.
// Move to real per-profile accounts with uid-scoped paths if the data itself must be
// private.
//
// Deliberately has NO time-based expiry -- the original test-mode rule would have
// denied all requests after 2026-09-10 and silently broken the app.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The admin password lives in Firebase Auth, never in the client bundle.
    // request.auth.token is signed by Firebase and cannot be forged by a client.
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'the4techies@gmail.com';
    }

    // /profiles/{profileId}
    match /profiles/{profileId} {
      allow read:           if signedIn();
      allow create, update: if signedIn();
      allow delete:         if isAdmin();

      // /profiles/{profileId}/progress/{topicId}
      // Sessions write here constantly, so ordinary clients need create and update.
      match /progress/{topicId} {
        allow read:           if signedIn();
        allow create, update: if signedIn();
        allow delete:         if isAdmin();
      }
    }

    // /quizzes/{quizId}, where quizId is `{ownerProfileId}__{topicId}`.
    //
    // The owner is part of the document id so two profiles can each own a test whose
    // name slugifies the same way. With a bare topicId as the id, the second import
    // silently overwrote the first -- and because progress is keyed on topicId, it
    // also misattributed the first profile's mastery history to different questions.
    match /quizzes/{quizId} {
      // get(key, default) tolerates documents written before `shared` existed, so
      // there is no ordering dependency between publishing these rules and deploying
      // the client.
      function sharedFlag(data) {
        return data.get('shared', false);
      }

      allow read:   if signedIn();

      // A client may only ever create an unpublished test.
      allow create: if signedIn() && sharedFlag(request.resource.data) == false;

      // A client may edit its test freely but cannot change whether it is published.
      // Re-importing the same test as the same profile lands here.
      allow update: if signedIn()
                    && (sharedFlag(request.resource.data) == sharedFlag(resource.data) || isAdmin());

      allow delete: if isAdmin();
    }

    // Any path not matched above is denied by default -- Firestore grants access only
    // when a matching rule explicitly allows it.
  }
}
